# Copy to .env and fill in values. Every setting is optional — with an empty
# .env the app runs fully offline (hashing embedder, extractive generation,
# email dry-run).

# --- Generation (optional) -------------------------------------------------
# Set an OpenAI key to enable grounded LLM generation. Without it, the pipeline
# uses a deterministic offline extractive fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Force-disable the LLM even if a key is present: set USE_LLM=0
USE_LLM=auto

# --- Embeddings ------------------------------------------------------------
# auto (default) picks sbert when the `ml` extra is installed, else hashing.
# Force a backend: hashing (offline) | sbert (needs the `ml` extra) | openai
EMBED_BACKEND=auto
# Grounding-guard thresholds AUTO-SCALE with the resolved backend: the hashing
# embedder uses 0.20 (facts) / 0.15 (Ask), neural backends (sbert/openai) use
# 0.35 / 0.30. Uncomment only to override the auto-selected value.
#GROUNDING_THRESHOLD=0.20
#QA_GROUNDING_THRESHOLD=0.15
# Vector store: auto (FAISS if installed, else NumPy) | faiss | numpy
USE_FAISS=auto

# --- Custom sources (optional) ---------------------------------------------
# Users can ground on their own link instead of Wikipedia (Wikipedia stays the
# default). Timeout in seconds for fetching a user-supplied source URL.
URL_FETCH_TIMEOUT=10

# --- Email delivery --------------------------------------------------------
# Leave SMTP_HOST empty (or set EMAIL_DRY_RUN=1) to log emails instead of send.
EMAIL_DRY_RUN=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=facts@localhost

# --- Storage & scheduler ---------------------------------------------------
DB_PATH=subscriptions.db
# Worker poll interval in seconds.
SCHED_POLL_INTERVAL=60

# --- Admin (optional) ------------------------------------------------------
# If set, subscription management routes (list / delete / run-due) require an
# "X-Admin-Token" header matching this value. Unset = open (fine for local demo).
ADMIN_TOKEN=
